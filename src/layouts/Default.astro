---
import '../styles/global.css'
import MouseTrailer from '../components/MouseTrailer.svelte'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteMenu from '../components/SiteMenu.svelte'

interface Props {
  title?: string
}

const { title = 'Felix Hungenberg' } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-zinc-900">
    <MouseTrailer client:load />
    <SiteHeader />
    <slot />
    <SiteMenu client:load />
    <SiteFooter />
  </body>
</html>
